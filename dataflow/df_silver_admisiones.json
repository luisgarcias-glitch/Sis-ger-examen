{
	"name": "df_silver_admisiones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_admisions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
				"          admission_date = case(",
				"  regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(admission_date), 'yyyy-MM-dd'),",
				"  regexMatch(trim(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(admission_date), 'dd-MMM-yyyy'),",
				"  regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(trim(admission_date), 'MM-dd-yy'),",
				"  regexMatch(trim(admission_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(admission_date), 'MM/dd/yyyy'),",
				"  regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(admission_date), 'MMMM dd, yyyy')",
				"),",
				"          discharge_date = case(",
				"  regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(discharge_date), 'yyyy-MM-dd'),",
				"  regexMatch(trim(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),",
				"  regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(trim(discharge_date), 'MM-dd-yy'),",
				"  regexMatch(trim(discharge_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(discharge_date), 'MM/dd/yyyy'),",
				"  regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(discharge_date), 'MMMM dd, yyyy')",
				"),",
				"          department = case(startsWith(lower(trim(department)),'card'),'Cardiology',",
				"     startsWith(lower(trim(department)),'onc'),'Oncology',",
				"     startsWith(lower(trim(department)),'emer') || lower(trim(department))=='er','Emergency',",
				"     startsWith(lower(trim(department)),'ped') || startsWith(lower(trim(department)),'paed'),'Pediatrics',",
				"     startsWith(lower(trim(department)),'gen'),'General Surgery',",
				"     startsWith(lower(trim(department)),'neu') || startsWith(lower(trim(department)),'nue'),'Neurology',",
				"     startsWith(lower(trim(department)),'ortho'),'Orthopedics',",
				"     'Unknown')) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(admission_date) && !isNull(patient_id)) ~> filter1",
				"filter1, source2 exists(derivedColumn1@patient_id == source2@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}