{
	"name": "df_silver_billing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_billing_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "bronze_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"filter1 derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          amount = toDecimal(round(toDouble(trim(replace(replace(replace(amount,'$',''),'USD',''),',',''))), 2), 12, 2),",
				"          charge_type = iif(isNull(charge_type) || trim(charge_type)=='', 'Unknown', trim(charge_type)),",
				"          payment_status = initCap(lower(trim(payment_status))),",
				"          payment_date = case(",
				"  regexMatch(trim(payment_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'yyyy-MM-dd'),",
				"  regexMatch(trim(payment_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(payment_date), 'dd-MMM-yyyy'),",
				"  regexMatch(trim(payment_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(trim(payment_date), 'MM-dd-yy'),",
				"  regexMatch(trim(payment_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(payment_date), 'MM/dd/yyyy'),",
				"  regexMatch(trim(payment_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(payment_date), 'MMMM dd, yyyy')",
				")) ~> derivedColumn1",
				"source1 filter(!isNull(amount) && trim(amount) != '') ~> filter1",
				"derivedColumn1, source2 exists(derivedColumn1@admission_id == source2@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}