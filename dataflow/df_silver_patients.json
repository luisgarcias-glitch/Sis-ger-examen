{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_patients_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(trim(patient_id)),",
				"          full_name = trim(full_name),",
				"          gender = case(left(lower(trim(gender)),1)=='m','Male', left(lower(trim(gender)),1)=='f','Female','Other'),",
				"          date_of_birth = case(",
				"  regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(date_of_birth), 'yyyy-MM-dd'),",
				"  regexMatch(trim(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(date_of_birth), 'dd-MMM-yyyy'),",
				"  regexMatch(trim(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(trim(date_of_birth), 'MM-dd-yy'),",
				"  regexMatch(trim(date_of_birth), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(date_of_birth), 'MM/dd/yyyy'),",
				"  regexMatch(trim(date_of_birth), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(date_of_birth), 'MMMM dd, yyyy')",
				"),",
				"          email = replace(trim(email), ',', '.'),",
				"          phone = trim(phone),",
				"          address = trim(address),",
				"          insurance_provider = trim(insurance_provider)) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(patient_id) && !isNull(full_name) && full_name != '') ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}